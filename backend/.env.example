# ==========================================
# BloodLink Backend - Variables de Entorno
# Copia este archivo a `.env` para desarrollo local:
#   cp .env.example .env
# NUNCA subas el archivo `.env` a GitHub.
# ==========================================

# Configuración de la Aplicación
APP_NAME=BloodLink API
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Seguridad / Orígenes permitidos de CORS
# Usa '*' para permitir cualquier origen en desarrollo local.
# En producción, usa la URL de tu app/dominio: ej. https://miapp.com,http://localhost:3000
ALLOWED_ORIGINS=*

# Configuración de Base de Datos
# Por defecto se utiliza SQLite para desarrollo local sin requerir instalación previa.
# Para PostgreSQL: postgresql://DB_USER:DB_PASSWORD@DB_HOST:DB_PORT/DB_NAME
# Para MySQL:      mysql+pymysql://DB_USER:DB_PASSWORD@DB_HOST:DB_PORT/DB_NAME
DATABASE_URL=sqlite:///./bloodlink.db
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bloodlink_db

# Almacenamiento y Validación de Archivos
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,doc,docx,txt
UPLOAD_DIR=uploads

# TODO: Autenticación / JWT (cuando se implemente el módulo de login)
# SECRET_KEY=
# ACCESS_TOKEN_EXPIRE_MINUTES=30
